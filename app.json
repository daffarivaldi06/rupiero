{
  "expo": {
    "name": "Rupiero",
    "slug": "BudgetApp",
    "scheme": [
      "rupiero",
      "budgetapp"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#F4F1EA"
      },
      "backgroundColor": "#F4F1EA",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.daffarivaldi.budgetapp",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-latest-intent.js",
      "./plugins/with-release-signing.js",
      [
        "./plugins/with-night-window-background.js",
        {
          "color": "#16181D"
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BudgetWidget",
              "label": "Rupiero",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "description": "Sisa budget per mata uang dan catat cepat",
              "previewImage": "./assets/icon.png"
            }
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/ibm-plex-sans/400Regular/IBMPlexSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans/500Medium/IBMPlexSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans/600SemiBold/IBMPlexSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans/700Bold/IBMPlexSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-mono/500Medium/IBMPlexMono_500Medium.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#16181D"
          }
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#1C1B19",
                "dark": "#ECE8DF"
              },
              "colorControlActivated": {
                "light": "#1C1B19",
                "dark": "#ECE8DF"
              },
              "colorControlHighlight": {
                "light": "#D9D4C7",
                "dark": "#323843"
              },
              "windowBackground": {
                "light": "#FBFAF6",
                "dark": "#1F232A"
              },
              "textColorPrimary": {
                "light": "#1C1B19",
                "dark": "#ECE8DF"
              },
              "textColorSecondary": {
                "light": "#5F5B53",
                "dark": "#A39E93"
              },
              "textColorPrimaryInverse": {
                "light": "#F4F1EA",
                "dark": "#16181D"
              },
              "textColorSecondaryInverse": {
                "light": "#F4F1EA",
                "dark": "#16181D"
              }
            }
          }
        }
      ],
      "expo-localization"
    ]
  }
}
