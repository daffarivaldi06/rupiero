# Optional environment variables. The web build needs none of these. Real values never go in this file.

# --- Development only ---
# Put this in .env.local (Expo loads it). Sample data is added on the first launch of a development
# build; set to false to start empty.
# EXPO_PUBLIC_SEED_SAMPLE_DATA=

# --- Android release signing only ---
# Set these in the shell that runs Gradle; Gradle reads ORG_GRADLE_PROJECT_<name> as a project property.
# Without them, release builds are signed with the debug key.
# ORG_GRADLE_PROJECT_RUPIERO_UPLOAD_STORE_FILE=
# ORG_GRADLE_PROJECT_RUPIERO_UPLOAD_KEY_ALIAS=
# ORG_GRADLE_PROJECT_RUPIERO_UPLOAD_STORE_PASSWORD=
# ORG_GRADLE_PROJECT_RUPIERO_UPLOAD_KEY_PASSWORD=
